# URL pública do site (usada nos metadados de compartilhamento)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com

# Link oficial de pagamento (checkout). Enquanto vazio, os CTAs levam à seção de oferta.
NEXT_PUBLIC_CHECKOUT_URL=

# Preço exibido na oferta. Enquanto vazio, o valor não é exibido na página.
NEXT_PUBLIC_PRICE=
# Linha complementar opcional abaixo do preço (ex.: condições de parcelamento)
NEXT_PUBLIC_PRICE_NOTE=

# Informações comerciais opcionais. Só aparecem na página quando preenchidas.
NEXT_PUBLIC_ACCESS_INFO=
NEXT_PUBLIC_REFUND_POLICY=

# Rodapé
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
